# --- Database ---
# Local (running the app on the host, DB in docker on port 5433):
DB_URL=postgresql://myuser:mypassword@localhost:5433/mydb
# Inside docker-compose the app uses postgresql://myuser:mypassword@db:5432/mydb

# --- LLM provider ---
LLM_PROVIDER=anthropic
MODEL_NAME=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Job source APIs ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Scraper defaults (optional overrides) ---
SEARCH_QUERY=ai ml software
COUNTRY=de
RESULTS_PER_PAGE=100

# --- Tailoring ---
DEFAULT_CV_PATH=data/cv.pdf
